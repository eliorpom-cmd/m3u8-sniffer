{
  "manifest_version": 3,
  "name": "M3U8 Sniffer",
  "version": "2.2.1",
  "description": "Détecte les vidéos m3u8, bloque les pubs popup et télécharge en 1 clic.",
  "key": "",
  "permissions": [
    "webRequest",
    "storage",
    "clipboardWrite",
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "M3U8 Sniffer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}